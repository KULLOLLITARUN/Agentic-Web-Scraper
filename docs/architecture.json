  "cards": [
    {
      "dot": "amber",
      "title": "Mark",
      "items": [
        "Locate matches each record to a repeated block (3+ same-width siblings) in the screenshot layout",
        "That block gives the highlight box and the item's own link (open ↗); unsure means no box"
      ]
    },
    {
      "dot": "emerald",
      "title": "Pull",
      "items": [
        "Long pages are read in overlapping parts and merged",
        "If the model stops early, the rest of the page is read again",
        "Typed fields are checked; problems go back to the model (3 attempts)"
      ]
    },
    {
      "dot": "cyan",
      "title": "Live stream",
      "items": [
        "pipeline emits step, part_done, loaded_more, screenshot, highlights, warning, result",
        "api/main.py streams them as NDJSON; useScrape folds them into screen state"
      ]
    },
    {
      "dot": "rose",
      "title": "Limits",
      "items": [
        "Short rate limits are waited out; the daily quota falls back to a smaller model",
        "Model and provider names are kept out of the UI"
      ]
    }
  ]
